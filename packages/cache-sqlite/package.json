{
	"name": "@soda3js/cache-sqlite",
	"version": "0.0.0",
	"private": true,
	"description": "SQLite response cache for the Socrata SODA3 API",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soda3js/tools.git",
		"directory": "packages/cache-sqlite"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./node": "./src/node.ts",
		"./bun": "./src/bun.ts"
	},
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped",
		"build:dev": "rslib build --config-loader native --env-mode dev",
		"build:prod": "rslib build --config-loader native --env-mode npm",
		"prepare": "turbo run build:dev --output-logs=errors-only",
		"types:check": "tsgo --noEmit"
	},
	"dependencies": {
		"@soda3js/protocol": "workspace:*"
	},
	"devDependencies": {
		"@effect/experimental": "^0.60.0",
		"@effect/platform": "catalog:silk",
		"@effect/platform-node": "catalog:silk",
		"@effect/sql": "^0.51.0",
		"@effect/sql-sqlite-node": "^0.52.0",
		"@savvy-web/rslib-builder": "^0.19.1",
		"@savvy-web/vitest": "^1.2.2",
		"@types/node": "catalog:silk",
		"effect": "catalog:silk"
	},
	"peerDependencies": {
		"@effect/experimental": ">=0.60.0",
		"@effect/platform": ">=0.96.0",
		"@effect/sql": ">=0.51.0",
		"@effect/sql-sqlite-node": ">=0.52.0",
		"effect": ">=3.21.0"
	},
	"peerDependenciesMeta": {
		"@effect/sql-sqlite-node": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev",
		"linkDirectory": true,
		"targets": [
			{
				"protocol": "npm",
				"registry": "https://npm.pkg.github.com/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			},
			{
				"protocol": "npm",
				"registry": "https://registry.npmjs.org/",
				"directory": "dist/npm",
				"access": "public",
				"provenance": true
			}
		]
	}
}
