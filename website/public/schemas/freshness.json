{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$defs": {
		"DatasetFreshness": {
			"type": "object",
			"required": ["domain", "datasetId", "rowsUpdatedAt", "lastChecked", "ttl"],
			"properties": {
				"domain": {
					"type": "string",
					"description": "Socrata portal domain"
				},
				"datasetId": {
					"type": "string",
					"description": "Dataset identifier"
				},
				"rowsUpdatedAt": {
					"type": "number",
					"description": "Unix timestamp of last data update"
				},
				"lastChecked": {
					"type": "string",
					"description": "ISO 8601 timestamp of last freshness check"
				},
				"ttl": {
					"type": "number",
					"description": "Time-to-live in seconds"
				}
			},
			"additionalProperties": false,
			"description": "Tracks when a dataset was last checked for freshness (_freshness.json)",
			"title": "DatasetFreshness"
		}
	},
	"$ref": "#/$defs/DatasetFreshness"
}
