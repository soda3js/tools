{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$defs": {
		"CacheEntryMeta": {
			"type": "object",
			"required": [
				"key",
				"path",
				"contentType",
				"created",
				"datasetId",
				"domain",
				"rowsUpdatedAt",
				"sizeBytes",
				"ttl",
				"cleanable"
			],
			"properties": {
				"key": {
					"type": "string",
					"description": "Cache key hash"
				},
				"path": {
					"type": "string",
					"description": "Relative path to cached response body"
				},
				"contentType": {
					"type": "string",
					"description": "MIME type of cached response"
				},
				"created": {
					"type": "string",
					"description": "ISO 8601 timestamp when entry was cached"
				},
				"datasetId": {
					"type": "string",
					"description": "Dataset identifier"
				},
				"domain": {
					"type": "string",
					"description": "Socrata portal domain"
				},
				"rowsUpdatedAt": {
					"type": "number",
					"description": "Unix timestamp of dataset version"
				},
				"sizeBytes": {
					"type": "number",
					"description": "Size of cached response body in bytes"
				},
				"ttl": {
					"type": "number",
					"description": "Time-to-live in seconds"
				},
				"cleanable": {
					"type": "boolean",
					"description": "Whether this entry can be pruned"
				},
				"query": {
					"type": "string",
					"description": "SoQL query string that produced this response"
				}
			},
			"additionalProperties": false,
			"description": "Metadata sidecar for a cached API response (*.meta.json)",
			"title": "CacheEntryMeta"
		}
	},
	"$ref": "#/$defs/CacheEntryMeta"
}
